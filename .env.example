# ==============================================================================
# DeskID — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure values for your deployment:
#   cp .env.example .env
# All environment variables use the prefix AUTH_.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Server & Database (Required)
# ------------------------------------------------------------------------------
# Database URL (SQLite for local dev or PostgreSQL for production)
AUTH_DATABASE_URL=sqlite:///./auth.db
# PostgreSQL example:
# AUTH_DATABASE_URL=postgresql+psycopg://auth:secret@postgres:5432/auth

# JWT Issuer URL (Must be a stable public or origin URL matching auth service)
AUTH_ISSUER=http://127.0.0.1:8090

# Host and Port binding for the Auth service
AUTH_HOST=127.0.0.1
AUTH_PORT=8090

# ------------------------------------------------------------------------------
# 2. RSA Cryptographic Keypair (Required for RS256 JWT signing)
# ------------------------------------------------------------------------------
# Generate keys with: ./scripts/generate_keys.sh
AUTH_JWT_PRIVATE_KEY_FILE=./private.pem
AUTH_JWT_PUBLIC_KEY_FILE=./public.pem
AUTH_JWT_KID=deskid-1

# Alternatively pass keys inline (e.g. for serverless / container envs):
# AUTH_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# AUTH_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# ------------------------------------------------------------------------------
# 3. Token Lifetimes
# ------------------------------------------------------------------------------
# Access token expiration in minutes
AUTH_ACCESS_TOKEN_MINUTES=60
# Refresh token expiration in days (sliding rotation)
AUTH_REFRESH_TOKEN_DAYS=30

# ------------------------------------------------------------------------------
# 4. User Registration & Bootstrapping Policy
# ------------------------------------------------------------------------------
# Set to 'true' to allow public self-registration.
# Set to 'false' to require bootstrap token or admin invitation.
AUTH_OPEN_REGISTRATION=true

# Secret bootstrap token required to register the initial platform administrator
# when AUTH_OPEN_REGISTRATION is set to false.
AUTH_BOOTSTRAP_TOKEN=

# Default product audiences auto-granted to users upon signup (Comma-separated)
# e.g. AUTH_DEFAULT_AUDIENCES=deskid,keymint,switchboard,membrane
AUTH_DEFAULT_AUDIENCES=
AUTH_DEFAULT_ROLE=operator

# ------------------------------------------------------------------------------
# 5. Security Headers, CORS & Callbacks
# ------------------------------------------------------------------------------
# Allowed CORS origins for browser Single Page Apps (Comma-separated)
AUTH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8090,http://127.0.0.1:8090

# SPA Callback URL used for OAuth redirects and email verification links
AUTH_SPA_CALLBACK_URL=http://127.0.0.1:8090/auth#callback

# API Key for the POST /introspect token validation endpoint (empty = endpoint disabled)
AUTH_INTROSPECTION_API_KEY=

# ------------------------------------------------------------------------------
# 6. Email Service Integration (Verification & Password Resets)
# ------------------------------------------------------------------------------
# Base URL and API key for outgoing email microservice (empty = disabled)
AUTH_MAIL_BASE_URL=
AUTH_MAIL_API_KEY=

# From sender email and display name (All outgoing emails use these settings)
AUTH_MAIL_FROM_EMAIL=no-reply@opendesk.io
AUTH_MAIL_FROM_NAME=DeskID

# ------------------------------------------------------------------------------
# 7. Rate Limiting Configuration (Multi-Worker & Distributed)
# ------------------------------------------------------------------------------
# Globally enable or disable rate limiting ('true' | 'false')
AUTH_RATE_LIMIT_ENABLED=true

# Rate limit storage backend:
#   - 'memory' : Fast in-process sliding window (single replica / local dev)
#   - 'db'     : Shared database table rate_limit_entries (multi-worker synchronized)
#   - 'redis'  : Distributed Redis cache
AUTH_RATE_LIMIT_BACKEND=memory

# Redis URL (Required when AUTH_RATE_LIMIT_BACKEND=redis)
AUTH_RATE_LIMIT_REDIS_URL=redis://localhost:6379/0

# Rate limiting thresholds (requests per window)
AUTH_RATE_LIMIT_LOGIN=10
AUTH_RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REGISTER=10
AUTH_RATE_LIMIT_REGISTER_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_PASSWORD_RESET=5
AUTH_RATE_LIMIT_PASSWORD_RESET_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_VERIFY_EMAIL=10
AUTH_RATE_LIMIT_VERIFY_EMAIL_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_RESET_PASSWORD=5
AUTH_RATE_LIMIT_RESET_PASSWORD_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REFRESH=20
AUTH_RATE_LIMIT_REFRESH_WINDOW_SECONDS=60

# Reverse Proxy Rate Limiting (Enable only when behind a trusted proxy/WAF)
AUTH_RATE_LIMIT_TRUST_PROXY=false
AUTH_RATE_LIMIT_PROXY_HEADER=x-forwarded-for

# ------------------------------------------------------------------------------
# 8. Password Policy & Account Lockout
# ------------------------------------------------------------------------------
# Minimum character length for user passwords
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_PASSWORD_REQUIRE_UPPERCASE=false
AUTH_PASSWORD_REQUIRE_DIGIT=false

# Account verification & lockout protection
AUTH_REQUIRE_EMAIL_VERIFICATION=true
AUTH_ACCOUNT_LOCKOUT_MAX_ATTEMPTS=5
AUTH_ACCOUNT_LOCKOUT_DURATION_SECONDS=900

# ------------------------------------------------------------------------------
# 9. OAuth Social Providers (Google & GitHub)
# ------------------------------------------------------------------------------
# Leave client ID and secret empty to disable the provider
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_REDIRECT_URI=
AUTH_GOOGLE_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth
AUTH_GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
AUTH_GOOGLE_USERINFO_URL=https://www.googleapis.com/oauth2/v3/userinfo

AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
AUTH_GITHUB_REDIRECT_URI=
AUTH_GITHUB_AUTHORIZE_URL=https://github.com/login/oauth/authorize
AUTH_GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token
AUTH_GITHUB_USERINFO_URL=https://api.github.com/user
AUTH_GITHUB_EMAILS_URL=https://api.github.com/user/emails

# OAuth CSRF state TTL in seconds
AUTH_OAUTH_STATE_TTL_SECONDS=600

# ------------------------------------------------------------------------------
# 10. Database Connection Pooling (PostgreSQL only)
# ------------------------------------------------------------------------------
AUTH_DB_POOL_SIZE=5
AUTH_DB_MAX_OVERFLOW=10
AUTH_DB_POOL_TIMEOUT=30
